      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "increase(cotalk_auth_login_success_total{job=\"cotalk-app\"}[5m])", "legendFormat": "성공", "refId": "A" },
        { "expr": "increase(cotalk_auth_login_failure_total{job=\"cotalk-app\"}[5m])", "legendFormat": "실패", "refId": "B" }
