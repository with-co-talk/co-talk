          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 30,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "increase(cotalk_users_registered_total{job=\"cotalk-app\"}[1h])", "legendFormat": "신규 가입 (시간당)", "refId": "A" }
      ],
      "title": "사용자 가입 추이",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "align": "auto", "displayMode": "auto", "filterable": true, "inspect": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "RPS" }, "properties": [{ "id": "custom.displayMode", "value": "gradient-gauge" }, { "id": "min", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "P95 (ms)" }, "properties": [{ "id": "custom.displayMode", "value": "gradient-gauge" }, { "id": "color", "value": { "mode": "continuous-GrYlRd" } }, { "id": "min", "value": 0 }] }
        ]
