# ===========================================
# Co-Talk NAS 환경 설정
# ===========================================
# 이 파일을 복사하여 .env 파일로 만들고 값을 수정하세요
# cp .env.example .env

# ===========================================
# GitHub Container Registry 설정
# ===========================================
# GitHub 사용자명/저장소명 (예: nhn/co-talk)
GITHUB_REPO=YOUR_GITHUB_USERNAME/co-talk

# ===========================================
# 포트 설정 (NAS에서 사용 중인 포트와 충돌 방지)
# ===========================================
APP_PORT=18080
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# ===========================================
# 데이터베이스 설정
# ===========================================
DB_USERNAME=cotalk
# 반드시 강력한 비밀번호로 변경하세요!
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ===========================================
# Redis 설정
# ===========================================
# 반드시 강력한 비밀번호로 변경하세요!
# 생성 방법: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===========================================
# JWT 설정
# ===========================================
# JWT 서명에 사용되는 비밀키 (최소 32자 이상, Base64 인코딩 권장)
# 생성 방법: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY_AT_LEAST_32_CHARS
# JWT 토큰 만료 시간 (밀리초, 기본값: 24시간)
JWT_EXPIRATION=86400000

# ===========================================
# 암호화 설정
# ===========================================
# AES-256 암호화 키 (32바이트, Base64 인코딩)
# 생성 방법: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_BASE64_32_BYTES

# ===========================================
# 메시지 검색 블라인드 인덱스 (HMAC) 설정
# ===========================================
# 검색 토큰 생성용 HMAC 시크릿 — 필수 (미설정 시 앱이 fail-fast로 기동 실패).
# Base64 32바이트. ENCRYPTION_KEY와 반드시 다른 별도 값으로 새로 생성하세요.
# 생성 방법: openssl rand -base64 32
BLIND_INDEX_SECRET=CHANGE_ME_BLIND_INDEX_SECRET_BASE64_32_BYTES

# 기존 메시지 검색 토큰 백필 (1회성 관리 작업). 평시 false 유지.
# 백필 윈도우에서만 SEARCH_BACKFILL_ENABLED=true로 1회 기동 후 다시 false로 되돌리세요.
SEARCH_BACKFILL_ENABLED=false
SEARCH_BACKFILL_CHUNK_SIZE=500        # 한 트랜잭션 당 메시지 수
SEARCH_BACKFILL_THROTTLE_MILLIS=0     # 청크 사이 슬립(ms, 부하 제어)
SEARCH_BACKFILL_SKIP_EXISTING=true    # 이미 토큰이 있는 메시지는 건너뜀

# ===========================================
# MinIO (파일 저장소) 설정
# ===========================================
# 반드시 강력한 비밀번호로 변경하세요!
MINIO_ACCESS_KEY=cotalk-minio-admin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# Flutter에서 파일에 접근할 때 사용하는 URL
# NAS 외부 IP 또는 도메인으로 설정 (포트는 MINIO_API_PORT와 동일해야 함)
MINIO_PUBLIC_URL=http://YOUR_NAS_IP:19000

# ===========================================
# 모니터링 스택 설정 (선택적)
# docker-compose.monitoring.yml 사용 시에만 필요
# ===========================================
PROMETHEUS_PORT=19090
GRAFANA_PORT=13001
ZIPKIN_PORT=19411
LOKI_PORT=13100
ALERTMANAGER_PORT=19093

GRAFANA_ADMIN_USER=admin
# 반드시 강력한 비밀번호로 변경하세요!
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# NAS 도메인 (외부 접속용)
NAS_DOMAIN=localhost

# ===========================================
# 이메일 설정 (비밀번호 재설정용, 선택)
# ===========================================
# Gmail: smtp.gmail.com (앱 비밀번호 필요)
# Naver: smtp.naver.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===========================================
# Watchtower 알림 설정 (선택)
# ===========================================
# 배포 시 알림 받기 (Slack, Discord, Telegram 등)
# Slack: slack://token-a/token-b/token-c
# Discord: discord://token@webhookid
# Telegram: telegram://token@telegram?chats=chat-id
# 더 많은 옵션: https://containrrr.dev/shoutrrr/services/overview/
WATCHTOWER_NOTIFICATION_URL=

# ===========================================
# 프론트엔드 및 CORS 설정
# ===========================================
# 프론트엔드 URL (비밀번호 재설정 링크 등에 사용)
FRONTEND_URL=https://co-talk.sgyj-dev.synology.me
# CORS 허용 오리진 (쉼표로 구분하여 여러 개 설정 가능)
CORS_ALLOWED_ORIGINS=https://co-talk.sgyj-dev.synology.me,http://localhost:3000

# ===========================================
# Swagger UI 설정
# ===========================================
# Swagger에 표시될 서버 URL (외부 접근 가능한 URL로 설정)
SWAGGER_SERVER_URL=https://co-talk.sgyj-dev.synology.me
SWAGGER_SERVER_DESCRIPTION=Co-Talk API 서버 (운영)

# ===========================================
# 백업 설정
# ===========================================
# 백업 파일 보관 기간 (일)
BACKUP_RETENTION_DAYS=7

# ===========================================
# 알림 설정 (Alertmanager)
# ===========================================
# Slack 웹훅 URL (알림 채널로 메시지 전송)
# 생성 방법: https://api.slack.com/messaging/webhooks
# ⚠️ 실제 웹훅 URL을 이 파일에 커밋하지 마세요! .env 파일에만 설정하세요.
SLACK_WEBHOOK_URL=CHANGE_ME_SLACK_WEBHOOK_URL

# Critical 알림 수신 이메일 (쉼표로 구분하여 여러 개 설정 가능)
ALERT_EMAIL_TO=team@example.com

# SMTP 설정 (이메일 알림용)
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alertmanager@your-domain.com
SMTP_AUTH_USERNAME=your-email@gmail.com
SMTP_AUTH_PASSWORD=your-app-password

# Grafana URL (알림 내 링크용)
GRAFANA_URL=https://grafana.your-domain.com
